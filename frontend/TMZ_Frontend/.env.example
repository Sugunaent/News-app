# Application Environment Variables

# Public Site URL (used for card share links when deployed to production)
VITE_SITE_URL=https://themodernstories.in

# Required for Supabase authentication and live homepage/latest content.
# Set the same values in the Vite deployment environment (for example, Vercel).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8001
